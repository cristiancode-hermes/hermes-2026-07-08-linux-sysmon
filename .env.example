# ── Linux SysMon Config ──
# Copia este archivo a .env y ajusta según necesites

# Puerto para servidor HTTP (opcional, si se activa modo web)
PORT=8080

# Intervalo de refresco en segundos (modo monitor)
REFRESH_INTERVAL=2

# Archivo de log
LOG_FILE=/tmp/linux-sysmon.log

# Nivel de log (trace, debug, info, warn, error, critical)
LOG_LEVEL=info
